{
  "name": "omni-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "./node_modules/.bin/ng serve",
    "build": "./node_modules/.bin/ng build",
    "watch": "./node_modules/.bin/ng build --watch --configuration development",
    "test": "./node_modules/.bin/ng test",
    "test:ci": "./node_modules/.bin/ng test --watch=false --browsers=ChromeHeadlessCI",
    "build-launcher": "bash scripts/build-launcher.sh",
    "build-launcher:version": "LAUNCHER_VERSION=$npm_config_version bash scripts/build-launcher.sh",
    "test:launcher": "node launcher-e2e/launcher-e2e.mjs",
    "build:visual": "./node_modules/.bin/ng build --configuration visual",
    "test:visual": "node field-visual/field-visual.mjs",
    "serve:visual": "./node_modules/.bin/ng serve --configuration visual"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.15",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/google-maps": "^19.2.19",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@krista/field-types": "^0.0.92",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "crypto-js": "^4.2.0",
    "luxon": "^3.7.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "ngx-editor": "^18.0.0",
    "ngx-material-timepicker": "^13.1.1",
    "reconnecting-websocket": "^4.4.0",
    "rxjs": "~7.8.0",
    "sanitize-html": "^2.17.0",
    "uuid": "^13.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.17",
    "@angular/cli": "^19.2.19",
    "@angular/compiler-cli": "^19.2.0",
    "@types/crypto-js": "^4.2.2",
    "@types/google.maps": "^3.58.1",
    "@types/jasmine": "~5.1.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/uuid": "^10.0.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "libphonenumber-js": "^1.12.36",
    "minify": "^9.0.0",
    "pixelmatch": "^6.0.0",
    "playwright-core": "^1.49.0",
    "pngjs": "^7.0.0",
    "tslib": "^2.8.1",
    "typescript": "~5.7.2"
  }
}
