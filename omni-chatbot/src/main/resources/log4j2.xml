<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="error">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT" >
            <PatternLayout pattern="%5p | %t | %c{1} | %m{nolookups} %n"/>
        </Console>
        <Console name="Perf" target="SYSTEM_OUT" >
            <PatternLayout pattern="PERF  | %t | %m{nolookups} %n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Chatbot extension's own logs at INFO so operational/diagnostic lines
             (pool warm + consume, login pool-vs-fresh, invoker load steps) are
             visible in SigNoz. Everything else stays at WARN to avoid third-party
             INFO noise. additivity=false prevents double-logging via Root. -->
        <Logger name="app.krista.extensions.essentials.collaboration.omnichatbot" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
