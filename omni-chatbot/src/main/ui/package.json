{
  "name": "krista-chatbot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build-launcher": "bash scripts/build-launcher.sh",
    "build-launcher:version": "LAUNCHER_VERSION=$npm_config_version bash scripts/build-launcher.sh"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@krista/field-types": "0.0.92",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@react-google-maps/api": "2.20.7",
    "@types/google.maps": "^3.55.9",
    "axios": "1.12.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.10.5",
    "draft-convert": "^2.1.12",
    "draft-js-import-html": "^1.4.1",
    "i18next": "^25.4.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "libphonenumber-js": "^1.12.13",
    "rc-picker": "3.2.4",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-i18next": "^13.0.2",
    "react-router-dom": "^5.2.0",
    "react-virtuoso": "^4.14.0",
    "react-window": "^1.8.7",
    "recoil": "^0.7.7",
    "reconnecting-websocket": "^4.4.0",
    "sanitize-html": "^2.5.3",
    "uuid": "^13.0.0",
    "uuidv4": "^6.2.8",
    "ws": "^8.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.0/xlsx-0.20.0.tgz"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/draft-convert": "^2.1.4",
    "@types/draft-js": "^0.11.3",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-router-dom": "^5.1.7",
    "@types/react-window": "^1.8.5",
    "@types/sanitize-html": "^2.5.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "minify": "^9.0.0",
    "mkdirp": "^3.0.1",
    "typescript": "^5.2.2",
    "vite": "^7.1.3",
    "vite-plugin-html": "^3.2.1",
    "vite-plugin-svgr": "^4.5.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react-hooks/recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": 0
    }
  }
}
